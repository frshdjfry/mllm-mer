# Copy to .env (gitignored) and fill in. Never commit the real key.
# Model Studio (DashScope) API key for the region below; Singapore and Beijing keys differ.
DASHSCOPE_API_KEY=
# OpenAI-compatible endpoint, Singapore (international). Tested working 2026-11-24; the docs'
# workspace URL (https://<WorkspaceId>.ap-southeast-1.maas.aliyuncs.com/...) listed models but refused chat.
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
